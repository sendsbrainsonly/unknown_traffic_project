{
  "stage": "Stage 15R — Representation Bottleneck Audit",
  "created_utc": "2026-09-19",
  "claim_scope": "diagnostic",
  "strict_unknown_free": true,
  "forbidden_model_selection_roles": [
    "known_test",
    "unknown_test"
  ],
  "pilot_protocols": [
    {
      "dataset": "iscx_vpn",
      "protocol_id": "medium_seed2022",
      "setting": "medium",
      "seed": 2022,
      "reason": "middle-openness frozen protocol; representative 13-class application task"
    },
    {
      "dataset": "iscx_tor",
      "protocol_id": "medium_seed2022",
      "setting": "medium",
      "seed": 2022,
      "reason": "middle-openness frozen protocol; representative 8-class application/service task"
    },
    {
      "dataset": "vnat",
      "protocol_id": "medium_seed2025",
      "setting": "Medium",
      "seed": 2025,
      "reason": "pre-identified hard Known composition with rsync and scp both Known"
    },
    {
      "dataset": "vnat",
      "protocol_id": "medium_seed2026",
      "setting": "Medium",
      "seed": 2026,
      "reason": "pre-identified normal Known composition paired with the hard VNAT protocol"
    },
    {
      "dataset": "ustc",
      "protocol_id": "A-2",
      "setting": "A-2",
      "seed": 2022,
      "reason": "middle-openness positive-control protocol with strong existing Known classification"
    }
  ],
  "training": {
    "epochs": 100,
    "batch_size": 128,
    "eval_batch_size": 256,
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "betas": [0.9, 0.999],
    "weight_decay": 0.0,
    "scheduler": "MultiStepLR",
    "scheduler_milestones": [50, 80],
    "scheduler_gamma": 0.1,
    "checkpoint_criterion": "Known Validation accuracy; Macro-F1 is a co-reported diagnostic",
    "early_stopping": false,
    "training_seed": 2022,
    "augmentation": "RandomCrop(32,padding=4)+RandomHorizontalFlip for E1; none for E2/E3"
  },
  "e1": {
    "input": "frozen Open-Detect 32x32 uint8 image",
    "model": "torchvision ResNet18 with one input channel and a multiclass linear head",
    "objective": "CrossEntropyLoss",
    "removed_relative_to_e0": [
      "variational reconstruction objective",
      "Gaussian KL regularization",
      "prototype distance loss",
      "prototype reset"
    ]
  },
  "e2": {
    "max_packets": 8,
    "features": [
      "signed log1p(frame length)",
      "log1p(inter-arrival time in microseconds)",
      "valid-packet mask"
    ],
    "normalization": "Known-Train-only median/IQR, clip to [-4,4]",
    "model": "fixed two-block 1D-CNN (3->64->128 channels, kernel=3) with masked global pooling and linear head",
    "objective": "CrossEntropyLoss",
    "rationale": "eight packets matches the current Open-Detect information horizon and is supported by every frozen lineage"
  },
  "e3": {
    "model": "LightGBM multiclass",
    "implementation": "lightgbm 4.6.0 project-local wheel",
    "parameters": {
      "n_estimators": 500,
      "learning_rate": 0.05,
      "num_leaves": 31,
      "max_depth": -1,
      "min_child_samples": 20,
      "subsample": 1.0,
      "colsample_bytree": 1.0,
      "reg_alpha": 0.0,
      "reg_lambda": 0.0,
      "n_jobs": 4,
      "random_state": 2022,
      "deterministic": true,
      "force_col_wise": true,
      "early_stopping_rounds": 50,
      "checkpoint_criterion": "Known Validation multiclass_logloss"
    },
    "features": [
      "packet_count",
      "total_bytes",
      "duration",
      "packet_length_mean",
      "packet_length_std",
      "iat_mean",
      "iat_std",
      "forward_packet_count",
      "reverse_packet_count",
      "forward_reverse_ratio",
      "direction_changes",
      "payload_bytes_when_recoverable"
    ],
    "dependency_policy": "must use real lightgbm; no sklearn model may be relabeled as LightGBM"
  },
  "pilot_gate": {
    "clear_candidate_mean_delta_macro_f1": 0.03,
    "minimum_positive_protocols": 4,
    "maximum_allowed_worst_delta_macro_f1": -0.02,
    "diagnostic_candidate_mean_delta_macro_f1": 0.015,
    "diagnostic_minimum_positive_protocols": 3,
    "notes": "Gate is frozen before pilot training. A candidate failing the clear gate is not expanded to full protocols merely because of one high seed."
  }
}
